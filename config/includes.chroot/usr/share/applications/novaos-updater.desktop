[Desktop Entry]
Type=Application
Name=NovaOS Updater
Name[ar]=محدّث NovaOS
Comment=Check for and apply NovaOS system updates
Exec=x-terminal-emulator -e bash -c "sudo python3 /opt/novaos/updater/updater.py apply; echo; read -p 'Press Enter to close'"
Icon=system-software-update
Categories=System;
Terminal=false
