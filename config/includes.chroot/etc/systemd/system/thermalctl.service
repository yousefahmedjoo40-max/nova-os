[Unit]
Description=NovaOS ThermalCtl Daemon (fan/thermal/performance management)
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/novaos/thermalctl/thermalctl_daemon.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=novaos
RuntimeDirectoryMode=0755
Nice=-5
# الدايمون يحتاج صلاحيات root للكتابة في /sys/devices/system/cpu/*
User=root

[Install]
WantedBy=multi-user.target
