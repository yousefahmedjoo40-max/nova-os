#!/bin/bash
# تجهيز Flatpak/Flathub وتثبيت Prism Launcher، وربط سكربت أول تشغيل
set -e

flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
# نضيف التثبيت الفعلي هنا (يتطلب اتصال إنترنت وقت بناء الـ ISO)؛
# إن لم يتوفر اتصال، سيُنفَّذ أول مرة من سكربت first-run.sh بدلاً من ذلك.
chmod +x /opt/novaos/minecraft/first-run.sh

mkdir -p /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/novaos-minecraft-firstrun.desktop << 'AUTOSTART'
[Desktop Entry]
Type=Application
Name=NovaOS Minecraft Setup
Exec=/opt/novaos/minecraft/first-run.sh --silent-if-ready
X-GNOME-Autostart-enabled=true
NoDisplay=true
AUTOSTART

echo "[hook] إعداد Minecraft/Prism Launcher جاهز."
